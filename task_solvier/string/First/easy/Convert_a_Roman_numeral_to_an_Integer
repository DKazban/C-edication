#include <stdio.h>

int val(char c);

int main() {
    char in[] ="XCIX";
    int len = sizeof(in) / sizeof(in[0]);
    int sum = 0;
    int i = 0;
    for(i; i < len - 1; i++) {
            int current = val(in[i]);
            int next = val(in[i+1]);
            if(current >= next) {
                sum += current;
            }
            if(current < next) {
                sum -= current;
            }
    }
    
    printf("%d ", sum);

    return 0;
}

int val(char c) {

    switch (c) {
        case 'I':
            return  1;
            break;
        case 'V':
            return 5;
            break;
        case 'X':
            return 10;
            break; 
        case 'L':
            return 50;
            break;
        case 'C':
            return 100;
            break;
        case 'D':
            return 500;
            break;
        case 'M':
            return 1000;
            break;
        default:
            return 0;
        }


}

