#include <stdio.h>
void reverse(char str[], int left, int right);

int main() {
    char arr[] = "Techie Delight";
    int i = 0;
    int j = sizeof(arr) / sizeof(arr[0]);
    reverse(arr, i, j-2);
    printf("%s", arr);
    return 0;
}

void reverse(char str[], int left, int right) {
    if(left >= right) {
        return;
    }
    if(left != right) {
        char temp;
        temp = str[left];
        str[left] = str[right];
        str[right] = temp;
    }
    reverse(str, left + 1,right - 1);
}
