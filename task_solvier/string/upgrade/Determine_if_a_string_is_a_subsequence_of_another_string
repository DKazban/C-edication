#include <stdio.h>


int main() {
    char first[] = "xabcde";
    char second[] = "acb";

    int j = 0;
    for (int i = 0; first[i] != '\0' && second[j] != '\0'; i++) {
        if (first[i] == second[j]) {
            j++;
        }
    }

    if (second[j] == '\0') {
        printf("YE\n");
    } else {
        printf("no\n");
    }
    
    return 0;
}
