#include <stdio.h>
#include <string.h>
void reverse(char str[], int left, int right);

int main() {
    char arr[] = "Techie Delight";
    int i = 0;
    int j = strlen(arr);
    reverse(arr, i, j-1);
    printf("%s", arr);
    return 0;
}

void reverse(char str[], int left, int right) {
    if (left >= right) {
        return;
    }

    char temp = str[left];
    str[left] = str[right];
    str[right] = temp;

    reverse(str, left + 1, right - 1);
}
