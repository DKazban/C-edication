#include <stdio.h>
#include <string.h>
int main() {
    char arr[] = "ABCDBA";
    int len = sizeof(arr)/sizeof(arr[0]);
    int i = 0;
    int j = len-2;
    int win = 1;
    for(i; i < j;i++) {
        //printf("%c %c\n", arr[i],arr[j]);
        if(arr[i] != arr[j]) {
            win *= 0;
            printf("No");
            break;
        }
        
        j--;
    }
    if(win) {
        printf("Yes");
    }
    

    return 0;
}

