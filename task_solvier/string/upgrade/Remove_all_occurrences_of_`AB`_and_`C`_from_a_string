#include <stdio.h>
#include <string.h>
int main() {
    char arr[] = "CBAABCAB";
    int len = sizeof(arr)/sizeof(arr[0]);
    int j = 0;
    int i = 0;
    while(arr[i] != '\0') {
        if(arr[i] != 'C') {
            arr[j] = arr[i];
            j++;
        }
        if(j >= 2 && arr[j-2] == 'A' && arr[j-1] == 'B') {
            j -=2;
        }
        
        i++;
    }
    arr[j] = '\0';
    printf("%s",arr);

    return 0;
}

