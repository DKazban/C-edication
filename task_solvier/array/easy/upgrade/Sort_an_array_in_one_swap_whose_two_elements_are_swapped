int main() {
    int arr[] = {3, 8, 6, 7, 5, 9};
    int len = sizeof(arr) / sizeof(arr[0]);
    int x = -1;
    int y = -1;
    for(int i = 0; i < len-1; i++) {
        if(arr[i] > arr[i+1]) {
            if(x == -1) {
                x = i;
                y = i + 1;
            }
            else{
                y = i + 1;
            }
        }
    }
    int temp;
    temp = arr[x];
    arr[x] = arr[y];
    arr[y] = temp;
    for(int i = 0; i < len; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
    
}
