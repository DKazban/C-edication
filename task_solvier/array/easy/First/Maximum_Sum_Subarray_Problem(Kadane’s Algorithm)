int main() {

    int arr[] =  {2, 3, -8, 7, -1, 2, 3};

    int len = sizeof(arr) / sizeof(arr[0]);

    int sum = 0;

    int max = 0;

    int i = 0;

   

    while( i < len) {

        sum += arr[i];

        if((arr[i+1] + sum) > 0) {

            printf("%d ", arr[i]);

            if(sum > max) {

                max = sum;

            }

        }

        else{

            sum = 0;

        }

        i++;

    }

    printf("\n%d ", max);

    return 0;

   

}
