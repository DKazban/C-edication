int main() {
    int arr[] = {3, 8, 6, 7, 5, 9};
    int len = sizeof(arr) / sizeof(arr[0]);
    
    while(1) {
        int count = 1;
        for(int i = 0; i < len - 1; i++) {
            //printf("%d ", arr[i]);
            if(arr[i] > arr[i+1]) {
                int temp;
                temp = arr[i+1];
                arr[i+1] = arr[i];
                arr[i] = temp;
                count *= 0;
            }
        }
        if(count == 1) {
            break;
        }
    }
    for(int i = 0; i < len; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
    
}
